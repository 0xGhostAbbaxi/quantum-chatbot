# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it's already in .gitignore.

# Flask security key — generate a real random one.
SECRET_KEY=change-this-to-a-random-string

# Groq API Key — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# IBM Quantum Cloud credentials (optional) — https://quantum.ibm.com
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=

# Database URL (leave blank to use local SQLite)
# DATABASE_URL=

# Admin account — seeded on first run only
ADMIN_USERNAME=Abbasi
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

APP_ENV=development
